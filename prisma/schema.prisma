generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
	provider = "postgresql"
}

model User {
	id        		 Int   		       @id @default(autoincrement())
	sexe			 Boolean  		   @default(true)
	email     		 String    		   @unique
	password  		 String
	firstName    	 String
	lastName       	 String
	licence   		 String?
	phone			 String?
	bookings  		 Booking[]
	cotisationPayed  Boolean   		   @default(false)
	teamId           Int?
	team             Team?             @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
	captainedTeams   Team[]            @relation("TeamCaptain")
    indisponibilites Indisponibilite[]
	role			 SectionRole 	   @default(VISITEUR)
    section          Section?          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
	sectionId		 Int?
	memberSince		 DateTime? 		   @default(now())
	createdAt 		 DateTime  		   @default(now())
	updatedAt 		 DateTime 		   @updatedAt
}

model Section {
	id      Int             @id @default(autoincrement())
	nom     String          @unique
	members User[]
}

model Court {
	id       			Int       @id @default(autoincrement())
	nom      			String
	type     			CourtType @default(INTERIEUR)
	bookings 			Booking[]
	indisponibilites	Indisponibilite[]
}

model Booking {
	id         Int      @id @default(autoincrement())
	courtId    Int
	court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
	userId     Int
	user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
	dateDebut  DateTime
	statut     String   @default("confirmee")
	bookedAt   DateTime @default(now())

	@@unique([courtId, dateDebut])
}

model Indisponibilite {
	id            Int      @id @default(autoincrement())
	courtId       Int
	court         Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
	dateDebut     DateTime
	raison        String?
  	createdUserId Int
 	createdUser   User     @relation(fields: [createdUserId], references: [id], onDelete: Cascade)
  	createdAt     DateTime @default(now())
}

model News {
	id              Int      @id @default(autoincrement())
	titre           String
	contenu         String
	categorie       String
	adminId			Int
	datePublication DateTime @default(now())
}

model Team {
	id        Int      @id @default(autoincrement())
	name      String   @unique
	captainId Int?
	captain   User?    @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
	category  String
	division  String
	results   String?
	matchDay  String
	isEngaged Boolean @default(false)
	members   User[]  @relation("TeamMembers")
}

model Tournament {
	id                   Int      @id @default(autoincrement())
	nom                  String
	date                 DateTime
	description          String?
	inscriptionsOuvertes Boolean  @default(true)
}

enum SectionRole {
	DEVELOPPEUR
	PRESIDENT
	PRESIDENTE
	VICE_PRESIDENT
	VICE_PRESIDENTE
	TRESORIER
	TRESORIERE
	SECRETAIRE
	COACH
	MEMBRE
	VISITEUR
}

enum CourtType {
	INTERIEUR
	EXTERIEUR
}